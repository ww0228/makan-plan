<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="makanplan.view.RecipeBookController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="8" styleClass="app-root" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="8" left="12" right="12" top="8" />
            </padding>
                <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Recipe Book" />
                <Region HBox.hgrow="ALWAYS" />
                <TextField fx:id="searchField" prefWidth="360" promptText="Search recipe" />
                <Button onAction="#handleSearch" text="Search" styleClass="primary-yellow"/>
        </HBox>
    </top>

    <center>
        <SplitPane dividerPositions="0.35">
                <TableView fx:id="table" styleClass="elevated">
                    <columns>
                        <TableColumn fx:id="titleCol" editable="false" prefWidth="300" sortable="false" text="Title" />
                    </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
                </TableView>

                <VBox spacing="8" style="-fx-padding: 8;">
                        <!-- Single ImageView the controller updates -->
                        <ImageView fx:id="recipeImage" cache="true" fitWidth="420" preserveRatio="true" />
                        <TitledPane text="Ingredients">
                            <TextArea fx:id="ingredientsArea" editable="false" prefRowCount="8" wrapText="true" />
                        </TitledPane>
                        <TitledPane expanded="false" text="Instructions">
                            <TextArea fx:id="instructionsArea" editable="false" prefRowCount="10" wrapText="true" />
                        </TitledPane>
                        <Label />
                </VBox>
        </SplitPane>
    </center>
</BorderPane>
