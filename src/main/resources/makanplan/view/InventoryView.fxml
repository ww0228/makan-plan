<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="8.0" styleClass="app-root" stylesheets="@MakanPlan.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="makanplan.view.InventoryController">

    <padding>
        <Insets bottom="12" left="12" right="12" top="8" />
    </padding>

    <HBox alignment="CENTER" spacing="8">
            <Button alignment="CENTER" contentDisplay="CENTER" onAction="#handleAdd" styleClass="primary-yellow" text="Add" />
            <Button contentDisplay="CENTER" onAction="#handleEdit" styleClass="soft-dark" text="Edit" />
            <Button alignment="CENTER_RIGHT" contentDisplay="CENTER" onAction="#handleDelete" styleClass="danger-ghost" text="Delete" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="messageLabel" />
    </HBox>

    <TableView fx:id="table" styleClass="elevated">
        <columns>
            <TableColumn fx:id="nameCol" prefWidth="200.0" text="Name" />
            <TableColumn fx:id="catCol" prefWidth="200.0" text="Category" />
            <TableColumn fx:id="qtyCol" prefWidth="100.0" text="Qty" />
            <TableColumn fx:id="unitCol" prefWidth="100.0" text="Unit" />
            <TableColumn fx:id="expiryCol" prefWidth="150.0" text="Expiry" />
            <TableColumn fx:id="costCol" prefWidth="200.0" text="Cost" />
        </columns>
      <columnResizePolicy>
         <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
      </columnResizePolicy>
    </TableView>
</VBox>
